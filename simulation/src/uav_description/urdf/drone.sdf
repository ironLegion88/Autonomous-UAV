<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="endurance_quadcopter">
    <!-- Base Link: Represents the central avionics, battery, and flight controller -->
    <link name="base_link">
      <inertial>
        <!-- Mathematically calculated for a 1.50kg AUW 6-inch drone -->
        <mass>1.50</mass>
        <inertia>
          <ixx>0.0034</ixx>
          <iyy>0.0034</iyy>
          <izz>0.0060</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="base_visual">
        <geometry>
          <box><size>0.15 0.15 0.08</size></box>
        </geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient></material>
      </visual>

      <collision name="base_collision">
        <geometry>
          <box><size>0.15 0.15 0.08</size></box>
        </geometry>
      </collision>

      <!-- Virtual Pi Camera V2 attached to the front of the drone -->
      <sensor name="camera" type="camera">
        <pose>0.1 0 0.02 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.085</horizontal_fov> <!-- ~62 degrees FOV -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <!-- Bridges camera frames to ROS 2 topic via ros_gz_bridge -->
        <topic>/camera/image_raw</topic>
      </sensor>
      
      <!-- Virtual IMU for ArduPilot EKF3 -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>400</update_rate>
      </sensor>
    </link>

    <!-- ArduPilot Lockstep Plugin -->
    <!-- This intercepts physics from Gazebo and routes them to ArduPilot SITL -->
    <plugin filename="libArduPilotPlugin.so" name="ardupilot_gazebo::ArduPilotPlugin">
      <fdm_addr>127.0.0.1</fdm_addr>
      <fdm_port_in>9002</fdm_port_in>
      <fdm_port_out>9003</fdm_port_out>
      <modelXYZToAirplaneXForwardZDown>0 0 0 3.141593 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED>0 0 0 3.141593 0 0</gazeboXYZToNED>
      
      <!-- Motor mappings for ArduPilot Quad X configuration -->
      <control channel="0"><type>VELOCITY</type><offset>0</offset><p_gain>0.2</p_gain><multiplier>838</multiplier></control>
      <control channel="1"><type>VELOCITY</type><offset>0</offset><p_gain>0.2</p_gain><multiplier>838</multiplier></control>
      <control channel="2"><type>VELOCITY</type><offset>0</offset><p_gain>0.2</p_gain><multiplier>838</multiplier></control>
      <control channel="3"><type>VELOCITY</type><offset>0</offset><p_gain>0.2</p_gain><multiplier>838</multiplier></control>
    </plugin>
  </model>
</sdf>